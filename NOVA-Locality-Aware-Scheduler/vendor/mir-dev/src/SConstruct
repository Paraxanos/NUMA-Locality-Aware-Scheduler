######################
# Common environment #
######################

import os
import sys

def versiontuple(v):
    return tuple(map(int, (v.split("."))))

MIR_ROOT = os.environ.get('MIR_ROOT')
if(MIR_ROOT == None):
    # Use the parent directory of the directory this SConstruct resides in.
    MIR_ROOT = os.path.abspath("..")

sys.path.append(MIR_ROOT + '/scripts')

# Check for PAPI support
if os.path.isfile('HAVE_PAPI'):
    PAPI_ROOT = os.environ.get('PAPI_ROOT')
    if(PAPI_ROOT == None):
        if os.path.isfile('/usr/include/papi.h'):
            print('PAPI_ROOT not defined. Using /usr as PAPI_ROOT.')
            PAPI_ROOT="/usr"
        else:
            print('PAPI_ROOT is not defined and papi.h can not be found. Aborting!')
            Exit(2)

# Base environment
env = Environment(ENV = os.environ)
# Note: OpenMP support only enabled for GCC. 
env['CC'] = ['gcc']
# -D_XOPEN_SOURCE=600 needed for exposing pthread_barrier_t on recent Linux.
env['CCFLAGS'] = Split("""
-Wall 
-Werror 
-Wno-unused-function 
-Wno-unused-variable 
-Wno-unused-label
-fPIC 
-std=c99 
-D_GNU_SOURCE
-D_XOPEN_SOURCE=600
""")

if os.path.isfile(MIR_ROOT+'/src/mir_omp_int.c'):
    env['CCFLAGS'] += ['-DMIR_GPL']

env['CCFLAGS'] += ['-I' + MIR_ROOT+'/src']

# Enable libnuma usage
if os.path.isfile('HAVE_LIBNUMA'):
    env['CCFLAGS'] += ['-DMIR_MEM_POL_ENABLE']

# HAL-Sim: no real NUMA hardware behind this build; allocate_coarse/fine/local synthetically
# stamp a logical node id instead of calling real libnuma placement calls, and node_cache is
# populated by synthetic round-robin instead of querying real page placement.
# See docs/14-numa-opteron-implementation-plan.md Step 2.
if os.path.isfile('HAVE_ARCH_SIMULATED'):
    env['CCFLAGS'] += ['-DMIR_ARCH_SIMULATED']  # MIR_MEM_POL_CACHE_NODES already unconditional in mir_defines.h

# gem5 FS-mode migration: allocate_coarse/local back each allocation with real physical memory
# via a /dev/mem arena (arch/mir_arch_gem5numa8.c), instead of HAL-Sim's synthetic malloc() stamp.
# See docs/17-gem5-migration-plan.md section5.1/section11.
if os.path.isfile('HAVE_ARCH_GEM5SIM'):
    env['CCFLAGS'] += ['-DMIR_ARCH_GEM5SIM']

# NOVA scheduling extension (ALLoC): compiles src/scheduling/nova/ and registers policy_nova_a /
# policy_nova_ab / policy_nova. See docs/10-nova-architecture.md section9/section12.
if os.path.isfile('HAVE_NOVA_ENABLE'):
    env['CCFLAGS'] += ['-DMIR_NOVA_ENABLE']

# Enable PAPI usage
if os.path.isfile('HAVE_PAPI'):
    env['CCFLAGS'] += ['-I' + PAPI_ROOT+'/include']
    env['CCFLAGS'] += ['-DMIR_RECORDER_USE_HW_PERF_COUNTERS']

# Enable specialized support for GCC OpenMP Pre-4.9.0.
import subprocess
compiler_version = subprocess.getoutput(str(env['CC']).strip('[]') + ' -dumpversion')
compiler_name = subprocess.getoutput(str(env['CC']).strip('[]') + ' --version')
if versiontuple(compiler_version) < versiontuple("4.9.0") and compiler_name.startswith("gcc"):
    print('Enabling GCC Pre-4.9.0 OpenMP support')
    env['CCFLAGS'] += ['-DGCC_PRE_4_9']

# Topology auto-detection (detect_arch.R + generate_arch.py) is SKIPPED here:
# it requires R + data.table and only (re)generates arch/mir_arch_this.c, which we
# supply by hand as a static file instead (see project docs/14, "arch_this" patch note).
# Original behaviour preserved for real-hardware builds by restoring the two os.system()
# calls below if R is available.
if not env.GetOption('clean'):
    #if not os.path.isfile('mir_lib_int.h'):
    # FIXME: This runs every time rather than only when sources have changed.
    print('Generating library interface ...')
    if(0 != os.system(MIR_ROOT+'/src/generate_public_int.sh '+MIR_ROOT+'/src')):
        print('Could not generate library interface. Build cannot continue!')
        Exit(2)

#####################
# Debug environment #
#####################

debug = env.Clone();
debug['CCFLAGS'] += Split("""
-O0
-g
-ggdb
-DMIR_ENABLE_DEBUG
""")
debug.VariantDir('debug-build', MIR_ROOT+'/src', duplicate=0)
debug_src = debug.Glob('debug-build/*.c')
debug_src += debug.Glob('debug-build/arch/*.c')
debug_src += debug.Glob('debug-build/scheduling/*.c')
debug_src += debug.Glob('debug-build/scheduling/nova/*.c') # NOVA, docs/10-nova-architecture.md section12
debug.Library(target = 'mir-debug', source = debug_src)

###################
# Opt environment #
###################

opt = env.Clone();
opt['CCFLAGS'] += ['-O2']
opt.VariantDir('opt-build', MIR_ROOT+'/src', duplicate=0)
opt_src = opt.Glob('opt-build/*.c')
opt_src += opt.Glob('opt-build/arch/*.c')
opt_src += opt.Glob('opt-build/scheduling/*.c')
opt_src += opt.Glob('opt-build/scheduling/nova/*.c') # NOVA, docs/10-nova-architecture.md section12
opt.Library(target = 'mir-opt', source = opt_src)

###################
# Prof environment #
###################

prof = env.Clone();
prof['CCFLAGS'] += Split("""
-O2
-g
-ggdb
-finstrument-functions
-DMIR_ENABLE_PROF
""")
prof.VariantDir('prof-build', MIR_ROOT+'/src', duplicate=0)
prof_src = prof.Glob('prof-build/*.c')
prof_src += prof.Glob('prof-build/arch/*.c')
prof_src += prof.Glob('prof-build/scheduling/*.c')
prof_src += prof.Glob('prof-build/scheduling/nova/*.c') # NOVA, docs/10-nova-architecture.md section12
prof.Library(target = 'mir-prof', source = prof_src)
