diff --git a/src/mir_queue.c b/src/mir_queue.c
index 17d28fd..c8102a5 100644
--- a/src/mir_queue.c
+++ b/src/mir_queue.c
@@ -3,6 +3,8 @@
 #include "mir_memory.h"
 #include "mir_queue.h"
 #include "mir_utils.h"
+#include "mir_runtime.h"
+#include "scheduling/mir_sched_pol.h"
 
 struct mir_queue_t* mir_queue_create(uint32_t capacity)
 { /*{{{*/
@@ -100,3 +102,57 @@ uint32_t mir_queue_size(const struct mir_queue_t* queue)
     return size;
 } /*}}}*/
 
+// NOVA: Get queue size for a specific node's main queue
+uint32_t mir_get_node_queue_size(uint16_t node_id) {
+    if (!runtime || !runtime->sched_pol || node_id >= runtime->sched_pol->num_queues) return 0;
+    struct mir_queue_t* queue = (struct mir_queue_t*)runtime->sched_pol->queues[node_id];
+    return mir_queue_size(queue);
+}
+
+// NOVA: Get the main queue for a node
+struct mir_queue_t* mir_get_node_queue(uint16_t node_id) {
+    if (!runtime || !runtime->sched_pol || node_id >= runtime->sched_pol->num_queues) return NULL;
+    return (struct mir_queue_t*)runtime->sched_pol->queues[node_id];
+}
+
+// NOVA: Pop from end of node queue (for fallback stealing)
+struct mir_task_t* mir_queue_pop_end(uint16_t node_id) {
+    if (!runtime || !runtime->sched_pol || node_id >= runtime->sched_pol->num_queues) return NULL;
+    struct mir_queue_t* queue = (struct mir_queue_t*)runtime->sched_pol->queues[node_id];
+    struct mir_task_t* task = NULL;
+    mir_queue_pop(queue, (void**)&task);
+    return task;
+}
+
+// NOVA: Lock and remove a specific task from a node queue
+bool mir_queue_lock_and_remove(uint16_t node_id, struct mir_task_t* task) {
+    if (!runtime || !runtime->sched_pol || node_id >= runtime->sched_pol->num_queues) return false;
+    struct mir_queue_t* queue = (struct mir_queue_t*)runtime->sched_pol->queues[node_id];
+
+    mir_lock_set(&(queue->deq_lock));
+    if (QUEUE_EMPTY(queue)) {
+        mir_lock_unset(&(queue->deq_lock));
+        return false;
+    }
+
+    // Search for the task in the queue
+    uint32_t idx = queue->out;
+    for (uint32_t i = 0; i < queue->size; i++) {
+        if (queue->buffer[idx] == task) {
+            // Found it - shift elements to remove it
+            // This is a simplified removal; in production, might need better approach
+            for (uint32_t j = i; j < queue->size - 1; j++) {
+                uint32_t src = (queue->out + j + 1) % queue->capacity;
+                uint32_t dst = (queue->out + j) % queue->capacity;
+                queue->buffer[dst] = queue->buffer[src];
+            }
+            queue->size--;
+            mir_lock_unset(&(queue->deq_lock));
+            return true;
+        }
+        idx = (idx + 1) % queue->capacity;
+    }
+
+    mir_lock_unset(&(queue->deq_lock));
+    return false;
+}
